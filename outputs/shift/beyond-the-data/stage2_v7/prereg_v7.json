 "failures_v7_can_cause": [
  "Check (b) stops from the laptop's arithmetic, on seeds 2-4 and on every confirmatory seed 5-9: on the laptop, check (b) always compares two different programs. The self-test forecasts it (P1b) and says NOT READY above 1e-5, but a forecast is not a proof. A stalling-world stop fails every mark M1-M4 of its group.",
  "'Re-make failed' (the laptop's run of the gate's call failed where the gate's did not): check (b) then compares the laptop's BCA program with a cloud-made actor; a stop there is labelled 'machine-caused (re-make failed)'.",
  "Memory exhaustion inside the stand-in rival: pinned code records any exception there as the rival failing, which fails M4 for the whole group; guarded by the memory reservations, labelled 'machine-caused: memory'.",
  "Other numerical failures on seeds 5-9 (a learner, a band fit or a fresh data check) are recorded as version 6 says; whether another machine would have failed the same way cannot be told."
 ],
 "governing": "Version 6 (prereg.json 9b38c7c48a303cfd67e5db6f137e3a162997bb533d86b3f7647e0467b91ca3b1) stays the governing document for everything this file does not list as changed. Each v7 phase needs both v6's approval and v7's.",
 "gpu": "processor only, as version 6; the GPU may be timed for information in a separate environment no phase uses",
 "handoff": null,
 "handoff_rule": {
  "alternative": "let them finish",
  "chosen": "before the full self-test (step 8); it cannot change after any P1 or P2 record exists",
  "inherited": "a phase is inherited when its final record or failed-on-record file is in the final snapshot with a matching sidecar; inherited phases never run on the laptop",
  "stop_rule_default": "stop at once",
  "way_back": "if v7 is not approved or the laptop refuses before its first phase starts, the cloud writes V7/handoff/WITHDRAWN.json and may resume v6; once a v7 phase has started, the cloud never resumes Stage 2"
 },
 "interruptions": {
  "done": "a phase is done when its final record or a failed-on-record file is present and verified",
  "exit_97": "a v7 refusal halts the run",
  "files": "every existing file of the phase's table row is moved (never deleted) to R7/interrupted/",
  "machine_wide": [
   "the boot id changed",
   "the runner sent the signal",
   "SIGHUP, SIGINT or SIGTERM",
   "no exit status recorded"
  ],
  "other": "any other non-zero exit, or exit 0 not done, halts new phases",
  "phase_specific": [
   "SIGKILL, SIGSEGV, SIGBUS or SIGABRT on the same boot, not sent by the runner",
   "the log ends in a memory error (MemoryError, RESOURCE_EXHAUSTED, 'out of memory')"
  ],
  "reruns": "machine-wide: without limit; phase-specific: twice automatically, then once alone, then unfinished",
  "unfinished": "retried until done; the user's --retry sets only when the next attempt (run alone) starts"
 },
